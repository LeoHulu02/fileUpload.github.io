<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My Files</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="bg-dark text-light">

<div class="container my-5">
  <h1 class="mb-4">My Uploaded Files</h1>

  <div>
    <a href="/files/upload" class="btn btn-primary mt-3">Upload New File</a>
    <a href="/dashboard" class="btn btn-secondary mt-3">Kembali</a>
  </div>

  <table class="table table-dark table-striped">
    <thead>
      <tr>
        <th>Filename</th>
        <th>Uploaded At</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% files.forEach(file => { %>
      <tr>
        <td><%= file.originalname %></td>
        <td><%= new Date(file.createdAt).toLocaleString() %></td>
        <td>
          <!-- Download -->
          <a href="/files/admin/download/<%= file.id %>" class="btn btn-success btn-sm m-1 d-none d-sm-inline">
            Download
          </a>
          <a href="/files/admin/download/<%= file.id %>" class="btn btn-success btn-sm m-2 d-inline d-sm-none" title="Download">
            <i class="bi bi-download"></i>
          </a>
          <!-- Delete -->
          <form action="/files/admin/delete/<%= file.id %>" method="POST" class="d-inline">
            <button type="submit" class="btn btn-danger btn-sm m-1 d-none d-sm-inline" onclick="return confirm('Are you sure to delete this file?')">
              Delete
            </button>
            <button type="submit" class="btn btn-danger btn-sm m-2 d-inline d-sm-none" title="Delete" onclick="return confirm('Are you sure to delete this file?')">
              <i class="bi bi-trash"></i>
            </button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
